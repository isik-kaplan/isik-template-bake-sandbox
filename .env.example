# Every variable below is read somewhere in this project (backend, frontend, or docker-compose).
# Required: no working default exists - the app/stack won't start without a real value.
# Missing Default: what the app falls back to if this var is left unset entirely.
# Required and Missing Default are mutually exclusive per variable.
#
# Missing Default vars are written commented out, and must stay that way. `KEY=` sets an empty
# string rather than leaving KEY unset, and the config layer only falls back when a var is absent -
# so an empty value skips the default and reaches the caster, which either rejects it outright
# (boolean) or hands the app "" where it documented a real fallback.
#
# Required vars below carry real, working local-dev values already - this file is meant to be
# copied straight to .env and just work, the same way Test Project itself was
# generated with a real answer for every prompt that has no sensible default.

# Used-By: backend (settings.py)
# Purpose: Django DEBUG flag - also gates the default email backend (console if true, smtp if false)
# Options: true, false
# Required
TEST_PROJECT__DEBUG=true

# Used-By: backend (settings.py)
# Purpose: Django SECRET_KEY
# Options: -
# Required
TEST_PROJECT__SECRET_KEY=local-insecure-secret-key-change-in-real-deployments

# Used-By: backend (settings.py -> apps.common.fields.EncryptedField)
# Purpose: enciphers every secret this app stores at rest, so a database dump does not carry usable
#   ones out with it. Its own value rather than SECRET_KEY: rotating a signing key is ordinary, and
#   should not silently cost every stored secret. scripts/setup.sh generates one for a deployment.
# Options: a Fernet key - 32 random bytes, url-safe base64. Generate one with
#   `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# Missing Default: (empty - an EncryptedField refuses to store a secret until this is set)
#TEST_PROJECT__CREDENTIAL_KEY=

# Used-By: docker-compose.yml (backend's network aliases), backend (settings.py -> ALLOWED_HOSTS,
#   django-hosts PARENT_HOST), server (nginx server_name)
# Purpose: the domain this app is served on - api./admin./auth. subdomains route to the backend,
#   the bare domain routes to the frontend
# Options: -
# Required
TEST_PROJECT__DOMAIN=testproject.test

# Used-By: docker compose itself, read before anything else - prefixes every container/volume/
#   network name so this stack never collides with another compose project on the same machine
# Purpose: this stack's Compose project name
# Options: -
# Required
COMPOSE_PROJECT_NAME=test-project

# Used-By: docker-compose.yml (server service)
# Purpose: host port nginx publishes on
# Options: -
# Missing Default: 80
#TEST_PROJECT__HTTP_PORT=

# Used-By: docker-compose.dev-tls.yml (server service) - local dev only, see scripts/dev-tls.sh
# Purpose: host port nginx publishes its local https on, once scripts/dev-tls.sh has run
# Options: -
# Missing Default: 443
#TEST_PROJECT__HTTPS_PORT=

# Used-By: docker compose itself - written by scripts/dev-tls.sh, local dev only
# Purpose: the compose files the stack is built from - dev-tls.sh adds docker-compose.dev-tls.yml,
#   which mounts the local certificate and publishes :443
# Options: -
# Missing Default: docker-compose.yml
#COMPOSE_FILE=

# Used-By: frontend (Node itself) - written by scripts/dev-tls.sh, local dev only
# Purpose: an extra CA Node trusts, so the frontend's server-side fetches verify the local https
#   certificate - /etc/dev-tls/ca.pem once dev-tls.sh has run
# Options: -
# Missing Default: (unset - only the system's own CAs are trusted)
#NODE_EXTRA_CA_CERTS=

# Used-By: backend (settings.py -> ALLAUTH_TRUSTED_PROXY_COUNT)
# Purpose: how many proxies in front of the backend append to X-Forwarded-For - allauth keys its rate
#   limits on the address this many entries from the right. Too low and every visitor shares the
#   proxy's address (one bucket for everyone); too high and a client-supplied entry is trusted, or
#   allauth refuses a request carrying fewer entries than this
# Options: a positive integer
# Missing Default: 2 (the TLS-terminating load balancer this mode needs in front of nginx, plus nginx)
#   - set to 1 below because local development has no load balancer: the browser talks to nginx
#   directly. scripts/setup.sh's deployment mode writes the real count; add one per further proxy,
#   each of which must append to X-Forwarded-For rather than replace it
TEST_PROJECT__TRUSTED_PROXY_COUNT=1

# Used-By: docker-compose.yml (server service)
# Purpose: host address nginx publishes on. Loopback suits a load balancer on the same host; one on another
#   host (an AWS ALB, say) needs this host's private address. Firewall the port to the load balancer alone:
#   whatever reaches nginx directly skips it, so TRUSTED_PROXY_COUNT above trusts a forged entry and nginx
#   passes on a client-chosen X-Forwarded-Proto (the scheme of emailed links and OAuth redirects)
# Options: an IP address of this host, or 0.0.0.0 for every interface
# Missing Default: 127.0.0.1
#TEST_PROJECT__HTTP_BIND=

# Used-By: backend (settings.py), database service (POSTGRES_DB)
# Purpose: Postgres/ParadeDB database name
# Options: -
# Required
TEST_PROJECT__DB__NAME=test_project

# Used-By: backend (settings.py), database service (POSTGRES_USER), healthcheck (pg_isready -U)
# Purpose: Postgres/ParadeDB user
# Options: -
# Required
TEST_PROJECT__DB__USER=test_project

# Used-By: backend (settings.py), database service (POSTGRES_PASSWORD)
# Purpose: Postgres/ParadeDB password - internal-network-only, never reachable from outside Docker
# Options: -
# Required
TEST_PROJECT__DB__PASSWORD=test_project

# Used-By: backend (settings.py)
# Purpose: Postgres/ParadeDB host
# Options: -
# Required
TEST_PROJECT__DB__HOST=database

# Used-By: backend (settings.py)
# Purpose: Postgres/ParadeDB port
# Options: -
# Required
TEST_PROJECT__DB__PORT=5432

# Used-By: backend (settings.py), broker service (RABBITMQ_DEFAULT_USER)
# Purpose: RabbitMQ/AMQP user
# Options: -
# Required
TEST_PROJECT__BROKER__USER=test_project

# Used-By: backend (settings.py), broker service (RABBITMQ_DEFAULT_PASS)
# Purpose: RabbitMQ/AMQP password - internal-network-only, never reachable from outside Docker
# Options: -
# Required
TEST_PROJECT__BROKER__PASSWORD=test_project

# Used-By: backend (settings.py)
# Purpose: RabbitMQ/AMQP host
# Options: -
# Required
TEST_PROJECT__BROKER__HOST=broker

# Used-By: backend (settings.py)
# Purpose: RabbitMQ/AMQP port
# Options: -
# Required
TEST_PROJECT__BROKER__PORT=5672

# Used-By: backend (settings.py -> STORAGES["default"]), docker-compose.yml (storage service, which
#   creates it locally; a real deployment provisions its own)
# Purpose: the S3 bucket uploads are stored in - lowercase letters, digits and hyphens only
# Options: -
# Required
TEST_PROJECT__STORAGE__BUCKET_NAME=test-project

# Used-By: backend (settings.py -> STORAGES["default"])
# Purpose: S3-compatible endpoint - the `storage` compose service (LocalStack) locally, your
#   provider's S3 endpoint (e.g. https://s3.eu-west-1.amazonaws.com) in a real deployment
# Options: -
# Required
TEST_PROJECT__STORAGE__ENDPOINT_URL=http://storage:4566

# Used-By: backend (settings.py -> STORAGES["default"])
# Purpose: S3 access key id - LocalStack accepts any value
# Options: -
# Required
TEST_PROJECT__STORAGE__ACCESS_KEY_ID=test

# Used-By: backend (settings.py -> STORAGES["default"])
# Purpose: S3 secret access key - LocalStack accepts any value
# Options: -
# Required
TEST_PROJECT__STORAGE__SECRET_ACCESS_KEY=test

# Used-By: backend (settings.py -> STORAGES["default"]), docker-compose.yml (storage service)
# Purpose: the bucket's region - also what the storage service creates the local bucket in
# Options: -
# Required
TEST_PROJECT__STORAGE__REGION_NAME=us-east-1

# Used-By: docker-compose.yml (storage service)
# Purpose: host port LocalStack's S3 endpoint is published on, on 127.0.0.1 only - for inspecting
#   the bucket by hand; the app itself never uses it
# Options: -
# Missing Default: 4566
#TEST_PROJECT__STORAGE__PORT=

# Used-By: apps.users.management.commands.setup (entrypoint.sh runs it on every backend start)
# Purpose: username for the seeded local-dev superuser, created once if no superuser exists yet
# Options: -
# Required
TEST_PROJECT__SETUP__SUPERUSER__USERNAME=admin

# Used-By: apps.users.management.commands.setup
# Purpose: email for the seeded local-dev superuser
# Options: -
# Required
TEST_PROJECT__SETUP__SUPERUSER__EMAIL=admin@testproject.test

# Used-By: apps.users.management.commands.setup
# Purpose: password for the seeded local-dev superuser
# Options: -
# Required
TEST_PROJECT__SETUP__SUPERUSER__PASSWORD=admin-change-me

# Used-By: backend (settings.py) - DEBUG picks console vs smtp on its own; this only exists to
#   force smtp *without* flipping DEBUG (e2e needs mailpit but must keep non-Secure cookies, which
#   DEBUG=false would break on a stack with no TLS termination)
# Purpose: Django email backend override
# Options: console, smtp
# Missing Default: (empty - falls back to console if DEBUG else smtp)
#TEST_PROJECT__EMAIL__BACKEND=

# Used-By: backend (settings.py)
# Purpose: SMTP host - only read when DEBUG is false (console backend is used under DEBUG instead)
# Options: -
# Required
TEST_PROJECT__EMAIL__SMTP__HOST=localhost

# Used-By: backend (settings.py)
# Purpose: SMTP port
# Options: -
# Required
TEST_PROJECT__EMAIL__SMTP__PORT=587

# Used-By: backend (settings.py)
# Purpose: SMTP username - may be an empty string for an SMTP server with no auth (e.g. Mailpit)
# Options: -
# Required
TEST_PROJECT__EMAIL__SMTP__USER=

# Used-By: backend (settings.py)
# Purpose: SMTP password - may be an empty string for an SMTP server with no auth (e.g. Mailpit)
# Options: -
# Required
TEST_PROJECT__EMAIL__SMTP__PASSWORD=

# Used-By: backend (settings.py)
# Purpose: whether the SMTP connection uses TLS - Mailpit's own SMTP listener doesn't speak it
# Options: true, false
# Missing Default: true
#TEST_PROJECT__EMAIL__SMTP__USE_TLS=

# Used-By: backend (settings.py, apps.users.adapters.account)
# Purpose: default "from" address for outgoing email
# Options: -
# Required
TEST_PROJECT__EMAIL__DEFAULT_FROM=noreply@testproject.test

# Used-By: backend (settings.py -> SOCIALACCOUNT_PROVIDERS)
# Purpose: OAuth client ID for the "google" social login provider - the app starts
#   fine without it, that provider's login button just won't complete its flow until configured
# Options: -
# Missing Default: (unset - that provider's login button won't work until configured)
#TEST_PROJECT__OAUTH__GOOGLE__CLIENT_ID=

# Used-By: backend (settings.py -> SOCIALACCOUNT_PROVIDERS)
# Purpose: OAuth client secret for the "google" social login provider
# Options: -
# Missing Default: (unset - that provider's login button won't work until configured)
#TEST_PROJECT__OAUTH__GOOGLE__CLIENT_SECRET=

# Used-By: backend (settings.py -> SOCIALACCOUNT_PROVIDERS)
# Purpose: OAuth client ID for the "github" social login provider - the app starts
#   fine without it, that provider's login button just won't complete its flow until configured
# Options: -
# Missing Default: (unset - that provider's login button won't work until configured)
#TEST_PROJECT__OAUTH__GITHUB__CLIENT_ID=

# Used-By: backend (settings.py -> SOCIALACCOUNT_PROVIDERS)
# Purpose: OAuth client secret for the "github" social login provider
# Options: -
# Missing Default: (unset - that provider's login button won't work until configured)
#TEST_PROJECT__OAUTH__GITHUB__CLIENT_SECRET=

# Used-By: backend (settings.py -> SOCIALACCOUNT_PROVIDERS)
# Purpose: OAuth client ID for the "openid_connect" social login provider - the app starts
#   fine without it, that provider's login button just won't complete its flow until configured
# Options: -
# Missing Default: (unset - that provider's login button won't work until configured)
#TEST_PROJECT__OAUTH__OPENID_CONNECT__CLIENT_ID=

# Used-By: backend (settings.py -> SOCIALACCOUNT_PROVIDERS)
# Purpose: OAuth client secret for the "openid_connect" social login provider
# Options: -
# Missing Default: (unset - that provider's login button won't work until configured)
#TEST_PROJECT__OAUTH__OPENID_CONNECT__CLIENT_SECRET=

# Used-By: backend (settings.py -> SOCIALACCOUNT_PROVIDERS)
# Purpose: base URL of the OpenID Connect issuer (its /.well-known/openid-configuration is
#   resolved from this) - openid_connect is generic, unlike every other provider here, so it has
#   no fixed issuer of its own to fall back on
# Options: -
# Missing Default: (unset - that provider's login button won't work until configured)
#TEST_PROJECT__OAUTH__OPENID_CONNECT__SERVER_URL=

# Used-By: backend (settings.py -> SOCIALACCOUNT_PROVIDERS)
# Purpose: names this specific OpenID Connect instance - openid_connect supports multiple distinct
#   issuers side by side, so unlike every other provider here its redirect/callback URL is built
#   from this value, not a fixed slug (/v0/provider-callback/oidc/<this>/login/callback/) - must
#   match whatever redirect_uri is registered on the IdP's side exactly
# Options: -
# Missing Default: openid_connect
#TEST_PROJECT__OAUTH__OPENID_CONNECT__PROVIDER_ID=

# Used-By: frontend build only (Docker build arg, inlined into the browser bundle by `next build`
#   - no runtime env can switch the browser SDK on afterwards)
# Purpose: Sentry DSN for browser-side errors - unset disables it
# Options: -
# Missing Default: (unset - Sentry disabled)
#NEXT_PUBLIC_SENTRY_DSN=

# Used-By: backend (settings.py) - sentry_sdk.init() is only called at all when this is truthy
# Purpose: Sentry DSN for backend errors - unset disables Sentry entirely. A captured request is
#   narrowed by the same allowlist as the request log (apps/common/logging/scrub.py), cookies are
#   dropped, and send_default_pii stays off
# Options: -
# Missing Default: (unset - Sentry disabled)
#TEST_PROJECT__SENTRY__DSN=

# Used-By: backend (settings.py -> LOGGING)
# Purpose: how log lines are drawn on stdout - one aligned line for a person, or one JSON object
#   per line for a log collector. Both carry the same fields (see apps/common/logging/)
# Options: console, json
# Missing Default: console
#TEST_PROJECT__LOGGING__FORMAT=

# Used-By: backend (apps/common/logging/redaction.py -> worth_logging)
# Purpose: which requests earn a "request" log line of their own. Whatever is logged, a body, query
#   string or header is only ever written by value when its name is on the allowlist in
#   apps/common/logging/redaction.py - everything else is reported as present and redacted
# Options: non-2xx, all, none
# Missing Default: non-2xx
#TEST_PROJECT__LOGGING__REQUESTS=

# Used-By: backend (apps/common/logging/redaction.py -> worth_logging)
# Purpose: a request at least this slow earns a line whatever its status, unless REQUESTS is none
# Options: milliseconds; 0 turns the slow-request rule off
# Missing Default: 1000
#TEST_PROJECT__LOGGING__SLOW_REQUEST_MS=
