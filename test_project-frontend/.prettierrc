{
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    ".*\\.css$",
    "^~(?:\/.*)?$",
    "^next(?:\/.*)?$",
    "^react(?:\/.*)?$",
    "^lucide-react(?:\/.*)?$",
    "^@/components(?:\/.*)?$",
    "^@(?:\/.*)?$",
    "^@test-project/.*$",
    "<THIRD_PARTY_MODULES>"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "overrides": [
    {
      "files": "*.css",
      "options": {
        "singleQuote": false
      }
    }
  ]
}
